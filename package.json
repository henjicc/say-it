{
  "name": "say-it",
  "version": "0.4.0",
  "author": "痕继痕迹",
  "private": true,
  "type": "module",
  "scripts": {
    "ui:dev": "vite",
    "ui:build": "vite build",
    "ui:preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "sdk-runtime:typecheck": "tsc -p tsconfig.sdk-runtime.json",
    "sdk-runtime:build": "node scripts/build-ai-sdk-runtime.mjs 工作区/sdk-runtime-build",
    "test:ui": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:ai:live": "node scripts/run-ai-live.mjs",
    "check": "npm run typecheck && npm run test:ui && npm run ui:build && npm run test:rust",
    "context-probe:build": "node scripts/build-context-probe.mjs",
    "context-probe:test": "ctest --test-dir src-tauri/target/context-probe-build -C Release --output-on-failure",
    "macos-speech:build": "node scripts/build-macos-speech.mjs",
    "tauri:dev": "npm run context-probe:build && node scripts/build-macos-speech.mjs --development && node scripts/run-tauri.mjs dev",
    "tauri:build": "npm run context-probe:build && npm run macos-speech:build && node scripts/run-tauri.mjs build",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@tauri-apps/cli": "^2.8.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "0.25.12",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@henjicc/ai-sdk": "0.2.3",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.24.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0",
    "zustand": "^5.0.0"
  }
}
